# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# AdMob Production Configuration (used ONLY in release builds when ADMOB_USE_PRODUCTION_IDS=true)
# Debug builds ALWAYS inject official Google AdMob Test IDs automatically to prevent policy violations.
# Configure real IDs in your local .env file or in the AI Studio Secrets panel before publishing to Google Play.
# ADMOB_USE_PRODUCTION_IDS=true
# ADMOB_PROD_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# ADMOB_PROD_BANNER_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# ADMOB_PROD_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# ADMOB_PROD_NATIVE_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ